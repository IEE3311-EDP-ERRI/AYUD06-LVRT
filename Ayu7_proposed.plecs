"dc = 650.0 ;\n\n% Modulation Indexes\nma = 1.0 ; \nmf = 400.0 ; \n\n% Carrier"
" \nVcr = Vdc ;\nfcr = mf*50 ;\nfsw = fcr ; \n\n\n% Sinusoidal reference\nVpea"
"k = 220.0*sqrt(2) ;\nfreq = 50 ;\n\nL = 2.5e-3;\nR = 0.5;\n\nwn = 2.0*pi*150."
"0;\nxi = 0.707;\nKp = 2.0*xi*wn*L-R\nKi = wn^2*L\n\n% Controlador iL\nwn_iL ="
" 2*pi*150 ; \nxi_iL = 0.707 ; \nKp_iL = 2*xi_iL*wn_iL*L - R \nKi_iL = (wn_iL*"
"wn_iL)*L \nVd_max = Vpeak *1.05  ; "
