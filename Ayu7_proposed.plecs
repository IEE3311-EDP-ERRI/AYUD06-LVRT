    Component {
      Type          Subsystem
      Name          "Three-Phase PLL2"
      Show          off
      Position      [685, 95]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-40, -60; 40, 60]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Three-Phase PLL"
      MaskDescription "Configurable PLL in continuous time-domain with two dif"
"ferent phase detection approaches. "
      MaskHelp      "qthelp:///components-by-category/threephasepll.html"
      MaskDisplay   "Icon:text(0, -5,'PLL')\n"
"-- Phase symbol\n"
"Icon:line({37, 31, 36}, {-8, -8, -12})\n"
"-- Magnitude symbol\n"
"Icon:line({37, 37}, {-3, 3})\n"
"Icon:circle(34, 0, 0.5)\n"
"Icon:line({31, 31}, {-3, 3})\n"
"-- Frequency text\n"
"if Dialog:get('units') ~= '1' then\n"
"\tIcon:text(34,10,'f')\n"
"else\n"
"\tIcon:text(34,10,'w')\n"
"end\n"
"-- 3-phase symbol\n"
"Icon:text( -4, 5, '3', 'FontSize', 10)\n"
"Icon:circle(4, 5, 3)\n"
"Icon:line({1, 7},{8, 2})"
      MaskDisplayLang "2"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      MaskInit      "if f0 <= 0\n"
"\tplecs('error', 'Error in parameter \"Nominal frequency\": Positive number e"
"xpected.'); return;\n"
"end\n"
"if Vpk < 0\n"
"\tplecs('error', 'Error in parameter \"Nominal input voltage\": Positive numb"
"er expected.'); return;\n"
"end\n"
"if not(isnumeric(kp))\n"
"\tplecs('error', 'Error in parameter \"Proportional gain Kp\": Finite numeric"
"al value expected.'); return;\n"
"end\n"
"if not(isnumeric(ki))\n"
"\tplecs('error', 'Error in parameter \"Integral gain Ki\": Finite numerical v"
"alue expected.'); return;\n"
"end\n"
"if not(isnumeric(k))\n"
"\tplecs('error', 'Error in parameter \"Filter gain k\": Finite numerical valu"
"e expected.'); return;\n"
"end\n"
"if not(isnumeric(theta0))\n"
"\tplecs('error', 'Error in parameter \"Initial phase-angle\": Finite numerica"
"l value expected.'); return;\n"
"end\n"
"if not(isnumeric(f0))\n"
"\tplecs('error', 'Error in parameter \"Nominal frequency\": Finite numerical "
"value expected.'); return;\n"
"end\n"
"if not(isnumeric(Vpk))\n"
"\tplecs('error', 'Error in parameter \"Nominal input voltage\": Finite numeri"
"cal value expected.'); return;\n"
"end\n"
"\n"
"if units == 1\n"
"\tf0 = f0/(2*pi);\n"
"\tunit = 1;\n"
"elseif units == 2\n"
"\ttheta0 = theta0*2*pi;\n"
"\tunit = 2;\n"
"else\n"
"\ttheta0 = theta0*pi/180;\n"
"\tunit = 2;\n"
"end\n"
"\n"
"Vrms = Vpk / sqrt(2);\n"
"w0 = 2*pi*f0;\n"
"Vnom = Vpk;\n"
"theta0 = mod(theta0, 2*pi);\n"
"if type == 1\n"
"\tbw = f0/2;\n"
"\tphase_margin = 60;\n"
"else\t\n"
"\tbw = f0;\n"
"\tphase_margin = 60;\n"
"end\n"
"wc = 2*pi*bw;\n"
"Ti = tan(phase_margin*pi/180)/wc;\n"
"if contr_design == 1\n"
"\tKp = wc;\n"
"\tKi = Kp/Ti;\n"
"\tk = 1/sqrt(2);\n"
"else\n"
"\tKp = kp;\n"
"\tKi = ki;\n"
"\tk = k;\n"
"end\n"
"wf = w0*k;\n"
      MaskDialogCallback "-- Dispaly Kp and Ki only if Advanced is configured"
"\n"
"if Dialog:get('contr_design') == '2' then\n"
"\tDialog:set('kp','Visible', true)\n"
"\tDialog:set('ki','Visible', true)\n"
"\tDialog:set('k','Visible', true)\n"
"else\n"
"\tDialog:set('kp','Visible', false)\n"
"\tDialog:set('ki','Visible', false)\n"
"\tDialog:set('k','Visible', false)\n"
"end\n"
"-- Display k Editbox only if DSRF and Advanced are configured\n"
"if Dialog:get('type') == '2' and Dialog:get('contr_design') == '2' then\n"
"\tDialog:set('k','Visible', true)\n"
"else\n"
"\tDialog:set('k','Visible', false)\n"
"end"
      Parameter {
        Variable      "type"
        Prompt        "PLL type"
        Type          FixedText
        PossibleValues {"SRF-PLL", "DSRF-PLL"}
        Value         "2"
        Show          on
        Tunable       off
        TabName       "Basic"
      }
      Parameter {
        Variable      "f0"
        Prompt        "Nominal frequency"
        Type          FreeText
        Value         "2*pi*freq"
        Show          off
        Tunable       off
        TabName       "Basic"
      }
      Parameter {
        Variable      "Vpk"
        Prompt        "Nominal input voltage (V)"
        Type          FreeText
        Value         "Vpeak"
        Show          off
        Tunable       off
        TabName       "Basic"
      }
      Parameter {
        Variable      "theta0"
        Prompt        "Initial phase-angle"
        Type          FreeText
        Value         "-pi*0.5"
        Show          off
        Tunable       off
        TabName       "Basic"
      }
      Parameter {
        Variable      "units"
        Prompt        "Units for frequency and phase"
        Type          FixedText
        PossibleValues {"rad/s, rad", "Hertz, p.u.", "Hertz, degree"}
        Value         "1"
        Show          off
        Tunable       off
        TabName       "Basic"
      }
      Parameter {
        Variable      "contr_design"
        Prompt        "Controller design"
        Type          FixedText
        PossibleValues {"Basic", "Advanced"}
        Value         "1"
        Show          off
        Tunable       off
        TabName       "Controller Design"
      }
      Parameter {
        Variable      "kp"
        Prompt        "Proportional gain Kp"
        Type          FreeText
        Value         "1"
        Show          off
        Tunable       off
        TabName       "Controller Design"
      }
      Parameter {
        Variable      "ki"
        Prompt        "Integral gain Ki"
        Type          FreeText
        Value         "1"
        Show          off
        Tunable       off
        TabName       "Controller Design"
      }
      Parameter {
        Variable      "k"
        Prompt        "Filter gain k"
        Type          FreeText
        Value         "1"
        Show          off
        Tunable       off
        TabName       "Controller Design"
      }
